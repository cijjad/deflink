# Copy to .env.local and adjust. Never commit real secrets.
DATABASE_URL=postgres://deflink:deflink@127.0.0.1:5432/deflink
DATABASE_SSL=false
APP_URL=http://localhost:3000
STORAGE_DIR=./.storage
# Optional AI extraction. Leave unset to use the deterministic rules engine.
# When set, ONLY the user's message text is sent to the provider.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
